{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "backend/server.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/backend/server.js" },
    { "source": "/(.*)",        "destination": "/index.html" }
  ]
}
